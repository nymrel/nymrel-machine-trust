{
  "name": "@nymrel/machine-trust",
  "version": "1.0.0",
  "description": "Dual-Audience Machine Trust & AI Search Discoverability Engine for Modern Web Applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "bin": {
    "machine-trust": "bin/machine-trust.js"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "npm run typecheck",
    "build": "npm run clean && tsc --pretty false",
    "test:unit": "node --test test/runner.js",
    "test:runner": "npm run test:unit",
    "test": "npm run build && npm run test:unit",
    "audit:ci": "npm audit --audit-level=high",
    "package:check": "npm pack --dry-run --ignore-scripts",
    "check": "npm run typecheck && npm test && npm run audit:ci && npm run package:check",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "seo",
    "machine-trust",
    "dual-audience",
    "json-ld",
    "schema-org",
    "llms-txt",
    "robots-txt",
    "ai-search",
    "oai-searchbot",
    "answer-first",
    "nymrel"
  ],
  "author": "Nymrel <contact@nymrel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymrel/nymrel-machine-trust.git"
  },
  "bugs": {
    "url": "https://github.com/nymrel/nymrel-machine-trust/issues"
  },
  "homepage": "https://github.com/nymrel/nymrel-machine-trust#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.19.1",
  "devDependencies": {
    "@types/node": "26.6.1",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
